# Example secrets for the grocery agent. Safe to commit: it holds no real values.
#
# Local setup: copy this file to .streamlit/secrets.toml (same folder) and fill in
# the real values. secrets.toml is gitignored. Never commit it.
#
# Streamlit Cloud: paste the same contents, with real values, into the app's
# Settings > Secrets box. The code reads them the same way in both places.
#
# Get the real values from Tyler directly, not over email or the repo.

[kroger]
# developer.kroger.com app: Production environment, Products + Locations APIs.
client_id = "YOUR_KROGER_CLIENT_ID"
client_secret = "YOUR_KROGER_CLIENT_SECRET"

[openai]
# Used for the agent (gpt-4.1), conversation summaries and the product check (gpt-4.1-mini).
api_key = "YOUR_OPENAI_API_KEY"

[neon]
# Long-term memory database. Use the DIRECT connection string (Neon dashboard >
# Connect > Connection pooling OFF). It starts with postgresql:// and ends with
# sslmode=require.
database_url = "YOUR_NEON_DIRECT_CONNECTION_STRING"
